  // Run task
  {
    "context": "Workspace",
    "bindings": {
      "alt-shift-r": [
        "task::Spawn",
        {
          "reveal_target": "center",
        },
      ],
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space r t": [
        "task::Spawn",
        {
          "reveal": "no_focus",
        },
      ],
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space p w": [
        "task::Spawn",
        { "task_name": "WIKI: Paste Image from Clipboard" },
      ],
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space p b": [
        "task::Spawn",
        { "task_name": "Blog: Paste Image from Clipboard" },
      ],
    },
  }
]
